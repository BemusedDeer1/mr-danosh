# توکن ربات دریافتی از @BotFather (الزامی)
BOT_TOKEN=

# کلید API دریافتی از Google AI Studio (الزامی)
GEMINI_API_KEY=

# یوزرنیم ربات بدون @ (الزامی، مثال: DaneshvarNazemBot)
BOT_USERNAME=

# شناسه عددی ادمین‌ها جداشده با کاما (الزامی، مثال: 123456789,987654321)
ADMIN_IDS=

# شناسه عددی گروه مجاز (اختیاری؛ در صورت پر شدن، ربات از گروه‌های دیگر خارج می‌شود)
GROUP_CHAT_ID=

# مسیر فایل دیتابیس SQLite
DATABASE_PATH=data/daneshvar.db

# نام مدل Gemini (الزامی - مقدار زیر را با آخرین مدل‌های Flash در مستندات Google تطبیق دهید)
AI_MODEL=gemini-2.5-flash

# تنظیمات رفتار و محدودیت‌های ربات
RESPONSE_PROBABILITY=0.06
MAX_REPLIES_PER_HOUR=20
MIN_REPLY_INTERVAL_SEC=5
DAILY_API_CALL_LIMIT=400

# تنظیمات تولید متن مدل
AI_TEMPERATURE=0.85
AI_MAX_OUTPUT_TOKENS=220
AI_ENABLE_SAFETY_FILTERS=true

# منطقه زمانی و سطح لاگ
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
